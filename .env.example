# ==============================================================================
# GENERAL CONFIGURATION (GARMIN MCP SERVER + TELEGRAM AI COACH)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Garmin Connect Credentials
# ------------------------------------------------------------------------------
# Option A: Base64 Encoded Tokens (Recommended for Cloud: Render, Cloud Run, Docker)
# Generated locally by running: uv run garmin-mcp-auth
GARMIN_TOKENS_BASE64=eyJ...

# Option B: Direct credentials (Email & Password)
# Note: May trigger rate limits (429) or IP blocks in cloud environments.
# GARMIN_EMAIL=your_email@example.com
# GARMIN_PASSWORD=your_password_here

# Option C: Credential files (Optional)
# GARMIN_EMAIL_FILE=/path/to/email.txt
# GARMIN_PASSWORD_FILE=/path/to/password.txt

# If your account was created on Garmin Connect China (garmin.cn)
# GARMIN_IS_CN=false

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Configuration (AI Coach Brain)
# ------------------------------------------------------------------------------
# Get your free Gemini API Key at Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Create a bot and get your token from @BotFather on Telegram: https://t.me/botfather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Security (Recommended): Limit bot access strictly to your Telegram user ID.
# Find your Telegram user ID by sending /id to @userinfobot on Telegram.
# TELEGRAM_ALLOWED_USER_ID=123456789

# Webhook URL (Optional - For Cloud Deployments like Cloud Run)
# If set, the bot will start in Webhook mode on $PORT instead of Polling mode.
# WEBHOOK_URL=https://garmin-coach-bot-xxxxx.a.run.app

# ------------------------------------------------------------------------------
# 4. Athlete & Coach Personalization (No code changes required)
# ------------------------------------------------------------------------------
# Local timezone for accurate date and morning briefing calculations (e.g. America/New_York, Europe/London, America/Mexico_City)
TIMEZONE=America/Mexico_City

# Athlete display name used by the AI coach
ATHLETE_NAME=Athlete

# Garmin watch model for tailored instructions (e.g. Forerunner 965, Fenix 7, EPIX Gen2, Venu 3)
GARMIN_DEVICE_MODEL=Garmin watch

# Primary sports focus (e.g. Marathon & Strength, Olympic Triathlon, Trail Running, Fitness)
COACH_SPORT_FOCUS=Running, swimming, cycling, and hybrid endurance training

# Custom coaching instructions or specific current goals (Optional)
# COACH_CUSTOM_PROMPT=Preparing for a sub-40 min 10k race in December. Prioritize Saturday long runs.

# Path to athlete profile file for detailed weekly schedule (Optional, see coach_profile.example.txt)
# COACH_PROFILE_FILE=coach_profile.txt

# ------------------------------------------------------------------------------
# 5. MCP Server Transport Settings (Optional - For Gemini CLI / Claude / Cursor)
# ------------------------------------------------------------------------------
# GARMIN_MCP_TRANSPORT=stdio          # stdio | streamable-http | sse
# GARMIN_MCP_HOST=127.0.0.1           # Bind address for HTTP transports
# GARMIN_MCP_PORT=8000                # Bind port for HTTP transports
# GARMIN_ENABLED_TOOLS=get_stats,get_activities,get_sleep_data  # Filter exposed tools
